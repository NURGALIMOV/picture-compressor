{
  "manifest_version": 3,
  "name": "Image Compressor",
  "short_name": "Image Compressor",
  "version": "1.0.0",
  "description": "A tool to compress images efficiently.",
  "icons": {
    "48": "logo48.svg",
    "128": "logo.png",
    "180": "logo180.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo48.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.svg", "logo.png", "logo180.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
