{
  "manifest_version": 3,
  "name": "Picture Compressor",
  "short_name": "Picture Compressor",
  "description": "Introducing Picture Compressor, a simple image compressor that reduces picture size and creates compressed images.",
  "version": "1.0.0",
  "icons": {
    "48": "logo48.svg",
    "128": "logo.png",
    "180": "logo180.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo48.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.svg", "logo.png", "logo180.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
