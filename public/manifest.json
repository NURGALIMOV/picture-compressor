{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_shortDesc__",
  "default_locale": "en",
  "short_name": "Picture Compressor",
  "version": "1.0.0",
  "icons": {
    "16":"icons/16.png",
    "48":"icons/48.png",
    "64":"icons/48.png",
    "128":"icons/128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.svg", "logo.png", "logo180.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
